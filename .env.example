# --- Postgres ---
POSTGRES_USER=moneo
POSTGRES_PASSWORD=change-me
POSTGRES_DB=moneo
POSTGRES_HOST=db
POSTGRES_PORT=5432

# --- Backend ---
# openssl rand -hex 32
SECRET_KEY=change-me-to-a-random-secret
ACCESS_TOKEN_EXPIRE_MINUTES=10080
CORS_ORIGINS=http://localhost:5173
# Курсы валют: https://www.exchangerate-api.com/ (или совместимый open.er-api.com, не требует ключа)
EXCHANGE_RATE_API_URL=https://open.er-api.com/v6/latest
# Создаёт демо-аккаунт (demo@moneo.example / DemoPass123) с тестовыми данными при
# старте backend — удобно для локального знакомства с проектом. В dev-стеке
# (docker-compose.yml) включено принудительно; в проде не задавайте эту переменную.
SEED_DEMO_DATA=false

# --- Frontend ---
VITE_API_URL=http://localhost:8000
FRONTEND_URL=http://localhost:5173

# --- Email (для восстановления пароля). Если не заполнено — ссылка пишется в лог backend ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=Moneo <no-reply@moneo.local>

# --- Прод: вариант с Caddy (docker-compose.prod.caddy.yml), когда на VPS нет своего nginx ---
DOMAIN=example.com
ACME_EMAIL=you@example.com

# --- Прод: вариант со своим nginx на хосте (docker-compose.prod.nginx.yml) ---
# Порт, на который frontend публикуется на 127.0.0.1 для хостового nginx
APP_PORT=8090

# В проде (за HTTPS, любой из двух вариантов) обязательно true
COOKIE_SECURE=false
